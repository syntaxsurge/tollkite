# EIP-712 payment token metadata used for x402 signatures.
NEXT_PUBLIC_PAYMENT_TOKEN_NAME=PYUSD
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=PYUSD
NEXT_PUBLIC_PAYMENT_TOKEN_LABEL=PYUSD
NEXT_PUBLIC_PAYMENT_TOKEN_VERSION=1
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=18
# Use eip3009 for tokens that support transferWithAuthorization; use permit2 for standard ERC-20 approve + Permit2 flows.
NEXT_PUBLIC_PAYMENT_TOKEN_TRANSFER_METHOD=eip3009
# Kite-compatible x402 facilitator for PYUSD settlement.
X402_FACILITATOR_URL=https://facilitator.pieverse.io

